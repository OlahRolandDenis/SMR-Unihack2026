# Copy to .env and fill in. Load with: uvicorn app.main:app --env-file .env
# Tiger Data connection string (from the Tiger Cloud console)
DATABASE_URL=postgresql://user:password@host:5432/tsdb?sslmode=require

# AI services
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Auth0 (the API identifier you create in Auth0 Dashboard -> Applications -> APIs)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://smart-lanterns-api

# Comma-separated emails allowed into the moderator dashboard
MODERATOR_EMAILS=mariomihaila2020@gmail.com

# Public base URL of this server (Vultr IP, plain HTTP for the ESP32!)
PUBLIC_BASE_URL=http://YOUR_VULTR_IP

# Comma-separated allowed CORS origins for the React app
CORS_ORIGINS=http://localhost:5173
